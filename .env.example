# Copy to .env for local development:  cp .env.example .env
#
# These are local-only development defaults. They are deliberately committed:
# there is no secret here, and every developer needs the same connection.
# Real credentials never live in this repo - see docs/ARCHITECTURE.md section 8.

POSTGRES_USER=fpp
POSTGRES_PASSWORD=fpp_local_dev
POSTGRES_DB=fpp
# 5433 avoids colliding with a Postgres already running on the host default.
POSTGRES_PORT=5433

DATABASE_URL=postgresql://fpp:fpp_local_dev@localhost:5433/fpp
