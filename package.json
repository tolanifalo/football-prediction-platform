{
  "name": "football-prediction-platform",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "py:lint": "uv run ruff check .",
    "py:typecheck": "uv run mypy",
    "py:test": "uv run pytest -q",
    "py:test:db": "uv run pytest -m db -q",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:check": "pnpm --filter @fpp/db db:check",
    "db:generate": "pnpm --filter @fpp/db db:generate",
    "db:migrate": "pnpm --filter @fpp/db db:migrate",
    "db:verify-generate": "pnpm --filter @fpp/db db:verify-generate",
    "db:verify-harness": "pnpm --filter @fpp/db db:verify-harness",
    "db:verify-partitions": "pnpm --filter @fpp/db db:verify-partitions",
    "db:verify-canonical": "pnpm --filter @fpp/db db:verify-canonical",
    "db:verify-external-ids": "pnpm --filter @fpp/db db:verify-external-ids",
    "verify": "pnpm -r typecheck && pnpm -r lint && pnpm py:lint && pnpm py:typecheck && pnpm py:test"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "turbo": "^2",
    "typescript": "^5.6",
    "typescript-eslint": "^8"
  }
}
